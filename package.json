{
  "name": "job-application-agent-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": ".venv/bin/uvicorn job_application_agent.api:app --host 127.0.0.1 --port 8000 --reload",
    "dev:api:local": "JOB_AGENT_ALLOW_LOCAL_AUTH=1 .venv/bin/uvicorn job_application_agent.api:app --host 127.0.0.1 --port 8000 --reload",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
