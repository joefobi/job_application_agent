VITE_API_BASE_URL=http://localhost:8000

# Preferred: real Google sign-in.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Optional local fallback. Leave false for normal `npm run dev` and
# `npm run dev:api`; use `npm run dev:local` with `npm run dev:api:local`
# to enable local sign-in on both sides.
VITE_ALLOW_LOCAL_AUTH=false

# Structured job boards to fetch during discovery. Format each entry as
# `slug` or `slug:Company Name`; separate entries with commas.
JOB_AGENT_GREENHOUSE_BOARDS=
JOB_AGENT_LEVER_SITES=
